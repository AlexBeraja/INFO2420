       alt="Rent A Pet Logo"
       id="logo"
       onmouseover="logoOn()"
       onmouseout="logoOff()">

  <!-- NAVIGATION -->
  <nav>
    <a href="Templates/Home.html">Home</a>
    <a href="Templates/AboutUs.html">About Us</a>
    <a href="Templates/Tributes.html">Tributes</a>
