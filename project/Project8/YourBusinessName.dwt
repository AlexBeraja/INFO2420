<!-- InstanceBeginEditable name="PageContent" -->
<section>
  <article>

    <h1>Welcome to Rent A Pet!</h1>

    <p>
      Welcome to Rent A Pet! If you love interacting with pets like we do,
      you’ll enjoy exploring our site. Check out our pet profiles and feel
      free to complete our survey.
    </p>

    <h2>Our Pets</h2>
    <div class="thumbnails">
      <img src="Templates/Images/Thumbnail1.png" alt="Rent a Dog">
      <img src="Templates/Images/Thumbnail2.png" alt="Rent a Cat">
      <img src="Templates/Images/Thumbnail3.png" alt="Rent a Bunny">
      <img src="Templates/Images/Thumbnail4.png" alt="Rent a Bird">
    </div>

    <h2>Pet Spotlight</h2>
    <p>
      Our pets bring comfort, companionship, and happiness to everyone they meet.
      <a href="Templates/Tributes.html#PetSpotlight">more >></a>
    </p>

  </article>
</section>
<!-- InstanceEndEditable -->

<footer>
  <p>
    <a href="mailto:yourname@email.com">Email the Webmaster</a>
  </p>
  <p>
    This website has been created solely for educational purposes.
  </p>
</footer>

